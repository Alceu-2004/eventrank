# .env.example - variáveis de ambiente do FRONTEND (Vite)
# Copie para .env.local e ajuste conforme o ambiente

# URL base da API backend
# Desenvolvimento local: pode deixar como está (o código já usa http://localhost:8080 como padrão)
# Produção (Vercel): defina com a URL pública do backend publicado no Render
# Exemplo: VITE_API_URL=https://eventrank-backend.onrender.com
VITE_API_URL=http://localhost:8080
