# .env.example - variáveis de ambiente do BACKEND
# Estas variáveis devem ser configuradas no painel do Render (Environment),
# não em um arquivo .env local (Spring Boot não carrega .env automaticamente).
# Use este arquivo apenas como referência do que precisa ser configurado.

# Conexão com o PostgreSQL (Neon, Render Postgres, Supabase, etc.)
SPRING_DATASOURCE_URL=jdbc:postgresql://SEU_HOST:5432/SEU_BANCO?sslmode=require
SPRING_DATASOURCE_USERNAME=seu_usuario
SPRING_DATASOURCE_PASSWORD=sua_senha

# Chave secreta do JWT (gere uma nova, não reutilize a que estava no código)
JWT_SECRET=gere_uma_chave_base64_nova_aqui
JWT_EXPIRATION=3600000

# URL(s) do frontend publicado, separadas por vírgula se houver mais de uma
CORS_ALLOWED_ORIGINS=https://seu-frontend.vercel.app

# Porta (o Render define isso automaticamente, não precisa configurar manualmente)
# PORT=8080
